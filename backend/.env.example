APP_NAME=AI Knowledge Hub
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_knowledge_hub
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=ai-knowledge-hub
AUTH_JWT_AUDIENCE=ai-knowledge-hub-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_FAILURE_BACKOFF_BASE_SECONDS=0.5
AUTH_REDIS_URL=redis://localhost:6379/0
AUTH_TOKEN_BLACKLIST_PREFIX=ai-knowledge-hub:auth:blacklist:
AUTH_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
AUTH_DEFAULT_ORGANIZATION_SLUG=default
AUTH_DEFAULT_ORGANIZATION_NAME=Default Organization
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_INDEX_PREFIX=knowledge_chunks_
ELASTICSEARCH_CONTENT_ANALYZER=cjk
ELASTICSEARCH_CONTENT_SEARCH_ANALYZER=cjk
ELASTICSEARCH_WRITE_REFRESH=wait_for
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
LLM_ROUTER_BASE_URL=
LLM_ROUTER_API_KEY=
LLM_ROUTER_MODEL=qwen-turbo
LLM_ROUTER_TIMEOUT_SECONDS=20
LLM_ANSWER_BASE_URL=
LLM_ANSWER_API_KEY=
LLM_ANSWER_MODEL=
LLM_ANSWER_TIMEOUT_SECONDS=40
RELEVANCE_LOW_SCORE_THRESHOLD=0.35
STORAGE_PROVIDER=aliyun-oss
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET=ai-knowledge-hub-xueyuan-dev
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STORAGE_PREFIX=raw/dev
OSS_PRESIGN_EXPIRE_SECONDS=900
UPLOAD_DEFAULT_PART_SIZE=5242880
UPLOAD_MAX_FILE_SIZE=10737418240
UPLOAD_TASK_EXPIRE_HOURS=24
UPLOAD_MAX_PART_RETRIES=5
UPLOAD_PRESIGN_BATCH_MAX_PARTS=20
UPLOAD_RECOMMENDED_PARALLELISM=3
UPLOAD_AUTO_CREATE_DOCUMENT=true
UPLOAD_AUTO_INDEX_ON_COMPLETE=true
UPLOAD_WORKER_ENABLED=true
UPLOAD_PROCESSING_BACKEND=celery
UPLOAD_JOB_POLL_INTERVAL_SECONDS=2
UPLOAD_JOB_MAX_WORKERS=4
UPLOAD_JOB_LEASE_SECONDS=3600
UPLOAD_DOWNLOAD_STAGE_CONCURRENCY=2
UPLOAD_INDEX_STAGE_CONCURRENCY=1
UPLOAD_JOB_MAX_RETRIES=3
UPLOAD_JOB_RETRY_BACKOFF_SECONDS=5
UPLOAD_JOB_RETRY_BACKOFF_MAX_SECONDS=300
UPLOAD_MAX_ACTIVE_TASKS_PER_ACTOR=20
UPLOAD_DAILY_QUOTA_BYTES=21474836480
UPLOAD_LOCAL_RETENTION_HOURS=24
UPLOAD_MAGIC_SNIFF_BYTES=8192
UPLOAD_ZIP_MAX_MEMBERS=5000
UPLOAD_ZIP_MAX_UNCOMPRESSED_BYTES=536870912
UPLOAD_ZIP_MAX_COMPRESSION_RATIO=200.0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=ai_knowledge_hub
CELERY_PUBLISHER_CONFIRM=true
CELERY_DEAD_LETTER_EXCHANGE=ai_knowledge_hub.dlx
CELERY_DEAD_LETTER_QUEUE=ai_knowledge_hub.dead
CELERY_DEAD_LETTER_ROUTING_KEY=dead
