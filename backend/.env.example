APP_NAME=AI Knowledge Hub
APP_ENV=development
DATABASE_URL=sqlite:///./data/sqlite/ai_knowledge_hub.db
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_INDEX_PREFIX=knowledge_chunks_
ELASTICSEARCH_CONTENT_ANALYZER=cjk
ELASTICSEARCH_CONTENT_SEARCH_ANALYZER=cjk
ELASTICSEARCH_WRITE_REFRESH=wait_for
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
